DEBUG=False
SECRET_KEY=change-me-long-random-string
# On Vercel the app's own domain is allowed automatically. Add a custom domain here if you use one.
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=
DB_NAME=postgres
DB_USER=postgres.xxxx
DB_PASSWORD=...
DB_HOST=aws-0-xx.pooler.supabase.com
DB_PORT=6543
GEMINI_API_KEY=...
# optional
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Supabase Storage (S3) for uploaded photos. Leave these empty for local dev (files stay in ./media)
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<region shown in the S3 connection settings, e.g. ap-south-1>
SUPABASE_S3_ACCESS_KEY=...
SUPABASE_S3_SECRET_KEY=...
SUPABASE_BUCKET=cv-media
SUPABASE_PUBLIC_BASE=https://<project-ref>.supabase.co/storage/v1/object/public/cv-media
